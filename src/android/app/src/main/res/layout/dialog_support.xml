<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/support_prompt_description"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_kofi"
        style="@style/LemonButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/kofi_link_button"
        app:icon="@drawable/ic_coffee"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_buymeacoffee"
        style="@style/LemonButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/buymeacoffee_link_button"
        app:icon="@drawable/ic_coffee"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp" />

</LinearLayout>
