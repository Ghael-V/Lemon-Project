<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cheat_panel_card"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Kept outside the scroll body below so the drag handle and close button are
             always reachable regardless of how much the body ends up scrolled. -->
        <LinearLayout
            android:id="@+id/cheat_panel_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/cheat_panel_title"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lemon_cheater" />

            <ImageButton
                android:id="@+id/cheat_panel_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emulation_done"
                android:src="@drawable/ic_clear" />

        </LinearLayout>

        <!-- Fixed height rather than wrap_content: a landscape handheld screen can easily be
             shorter than this panel's natural content height (title + input + buttons +
             status + result rows), which used to push the bottom of the panel off-screen.
             Scrolls internally instead of overflowing. -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cheat_value_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/lemon_cheater_value_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/cheat_value_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberSigned" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cheat_search_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/lemon_cheater_new_search" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cheat_refine_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/lemon_cheater_refine" />

                </LinearLayout>

                <!-- For when the exact value isn't known - snapshots memory now, then
                     Increased/Decreased below compares against it once the value has
                     changed in-game. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cheat_blind_search_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/lemon_cheater_blind_search" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cheat_increased_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/lemon_cheater_increased" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cheat_decreased_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/lemon_cheater_decreased" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cheat_unchanged_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/lemon_cheater_unchanged" />

                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/cheat_status_text"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:text="34 result(s)" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cheat_results_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_cheat_result" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
