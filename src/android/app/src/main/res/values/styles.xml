<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Custom button styles -->
    <style name="InGameMenuOption" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:gravity">center_vertical|left</item>
        <item name="android:paddingLeft">32dp</item>
        <item name="android:paddingRight">32dp</item>
    </style>

    <style name="LemonSlider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
    </style>

    <!-- Blue theme dialog -->
    <style name="LemonMaterialDialog.Blue" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/lemon_primaryContainer_blue</item>
        <item name="colorSurface">@color/lemon_primaryContainer_blue</item>
        <item name="colorSecondary">@color/lemon_primary_blue</item>
        <item name="android:textColorLink">@color/lemon_primary_blue</item>
        <item name="buttonBarPositiveButtonStyle">@style/LemonButton.Blue</item>
        <item name="buttonBarNegativeButtonStyle">@style/LemonButton.Blue</item>
        <item name="buttonBarNeutralButtonStyle">@style/LemonButton.Blue</item>
    </style>

    <style name="LemonButton.Blue" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/lemon_primary_blue</item>
        <item name="rippleColor">@color/lemon_inversePrimary_blue</item>
    </style>

