        <!-- Outline and borders -->
        <item name="colorOutline">@color/lemon_border</item>
        <item name="colorOutlineVariant">@color/lemon_border_light</item>
        <!-- Error colors -->
        <item name="colorError">@color/lemon_error</item>
        <item name="colorErrorContainer">@color/lemon_error</item>
        <item name="colorOnError">@color/lemon_on_primary</item>
        <item name="colorOnErrorContainer">@color/lemon_on_primary</item>
        <!-- System UI -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Other theme attributes -->
        <item name="android:shadowColor">@color/lemon_overlay</item>
        <item name="sliderStyle">@style/LemonSlider</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Material dialog theme -->
        <item name="materialAlertDialogTheme">@style/LemonMaterialDialog</item>
        <!-- Popup menu theme -->
        <item name="popupMenuStyle">@style/LemonPopupMenu</item>
        <item name="android:textColorPrimary">@color/lemon_on_background</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

