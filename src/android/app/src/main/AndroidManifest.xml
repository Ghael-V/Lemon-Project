<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lemon updates: the downloaded APK goes to Android's installer, which asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets EmulatorMigration find other yuzu-family emulators' user-folder document providers. -->
    <queries>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

    <application
        android:name="dev.ironlemon.ironlemon_emulator.YuzuApplication"
        android:label="@string/app_name_suffixed"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:hasFragileUserData="false"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:banner="@drawable/tv_banner"
        android:fullBackupContent="@xml/data_extraction_rules"
        android:dataExtractionRules="@xml/data_extraction_rules_api_31"
        android:enableOnBackInvokedCallback="true">

        <meta-data android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name="dev.ironlemon.ironlemon_emulator.ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IronLemon.Splash">

            <!-- This intentfilter marks this Activity as the one that gets launched from Home screen. -->
            <!-- GAME and Xiaomi's booster action: game boosters and launchers list the app as a game. -->
            <intent-filter>
                <action android:name="com.miui.gamecenter.GAME_BOOSTER_LAUNCH" />
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.ironlemon.ironlemon_emulator.features.settings.ui.SettingsActivity"
            android:theme="@style/Theme.IronLemon"
            android:label="@string/preferences_settings"/>

        <activity
            android:name="dev.ironlemon.ironlemon_emulator.activities.OverlayEditorActivity"
            android:theme="@style/Theme.IronLemon"
            android:exported="false" />

        <activity
            android:name="dev.ironlemon.ironlemon_emulator.activities.EmulationActivity"
            android:theme="@style/Theme.IronLemon"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true">

            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/octet-stream"
                    android:scheme="content"/>
            </intent-filter>

            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <receiver
            android:name=".widget.GameLauncherWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/game_widget_info" />
        </receiver>

        <provider
            android:name=".features.DocumentProvider"
            android:authorities="${applicationId}.user"
            android:grantUriPermissions="true"
            android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Name and icon of a game in the library, for frontends (read only, one game per query). -->
        <provider
            android:name=".features.LibraryProvider"
            android:authorities="${applicationId}.library"
            android:exported="true" />

    </application>

</manifest>
